# Cup2Eat Server Environment Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas Database URI
# Obtain from MongoDB Atlas -> Database -> Connect -> Drivers
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/cuptoeat?retryWrites=true&w=majority

# JWT Authentication Secret
JWT_SECRET=cuptoeat_production_grade_jwt_secret_token_key_2026

# Resend API for OTP & Transactional Emails
# Obtain from https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=Cup2Eat Orders <orders@cup2eat.com>

# Razorpay Payment Gateway (Test Mode / Live Mode)
# Obtain from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Cloudinary Storage for Product Imagery
# Obtain from https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Frontend Client URL
CLIENT_URL=http://localhost:5173

# Initial Admin Credentials (seeded on first boot)
ADMIN_EMAIL=admin@cup2eat.com
ADMIN_PASSWORD=Admin@Cup2Eat2026
